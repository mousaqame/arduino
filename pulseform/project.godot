; Engine configuration file.
; Pulseform — an original rhythm-driven platformer.
; This file is text on purpose: the whole game is built in code (see Scripts/),
; so there is almost nothing here that can rot or drift out of sync.

config_version=5

[application]

config/name="Pulseform"
config/description="An original rhythm-driven platformer. 100% original assets, music and branding, built in GDScript."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false
run/max_fps=0

[autoload]

EventBus="*res://Scripts/Core/EventBus.gd"
AudioDirector="*res://Scripts/Audio/AudioDirector.gd"
Settings="*res://Scripts/Core/Settings.gd"
SaveSystem="*res://Scripts/Core/SaveSystem.gd"
Game="*res://Scripts/Core/Game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16
common/physics_interpolation=false
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.043, 0.047, 0.09, 1)
anti_aliasing/quality/msaa_2d=1

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="solid"
2d_physics/layer_3="hazard"
2d_physics/layer_4="trigger"
