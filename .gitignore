# A separate project of its own, with its own repo. Not part of the Workshop.
gravixar-hq/

# Compiler output — regenerated by each project's flash.ps1
.build/
**/.build/

# Arduino CLI / arduino-cli compile output (folder is named build/, not .build/)
# — tens of MB of .elf/.map/.bin per board, all regenerable.
**/firmware/**/build/
**/sketch/**/build/

# Python
__pycache__/
**/__pycache__/
*.pyc

# Flash log — runtime data written by the dashboards, machine-specific.
flash_log.json
flash_log.json.tmp

# WiFi credentials — the robot reads these, they never leave this machine.
# The glob covers secrets.h and any kept copy like secrets.h.disabled.
robot/robot/secrets.h*

# Vercel's local project link, written by `vercel` in web/. Machine-specific,
# and there is no reason for it to be in a public repo.
.vercel/
**/.vercel/
